{
  "name": "altium365-scripting",
  "displayName": "Altium 365 Developer Tools",
  "description": "Browse Altium 365 workspaces, run and debug Python scripts locally with live API access, and manage remote scripts — all without leaving VS Code.",
  "version": "0.1.0",
  "publisher": "altium",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": ["Other"],
  "icon": "resources/icon.png",
  "keywords": ["altium", "altium365", "a365", "scripting", "pcb", "eda", "electronics"],
  "repository": {
    "type": "git",
    "url": "https://github.com/altium/a365-vscode-extension"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "altium365",
          "title": "Altium 365",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "altium365": [
        {
          "id": "altium365.tree",
          "name": "Workspaces"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "altium365.tree",
        "contents": "You are not signed in to Altium 365.\n\n[Sign In](command:altium365.signIn)\n\nLearn more about [Altium 365](https://www.altium.com/altium-365).",
        "when": "!altium365.signedIn"
      }
    ],
    "commands": [
      {
        "command": "altium365.runScript",
        "title": "Altium 365: Run Python Script",
        "category": "Altium 365"
      },
      {
        "command": "altium365.debugScript",
        "title": "Altium 365: Debug Python Script",
        "category": "Altium 365"
      },
      {
        "command": "altium365.signIn",
        "title": "Altium 365: Sign In",
        "category": "Altium 365"
      },
      {
        "command": "altium365.signOut",
        "title": "Altium 365: Sign Out",
        "category": "Altium 365"
      },
      {
        "command": "altium365.selectWorkspace",
        "title": "Altium 365: Select Workspace",
        "category": "Altium 365"
      },
      {
        "command": "altium365.selectEnvironment",
        "title": "Altium 365: Select Environment",
        "category": "Altium 365",
        "icon": "$(globe)"
      },
      {
        "command": "altium365.tree.refresh",
        "title": "Altium 365: Refresh Workspaces",
        "category": "Altium 365",
        "icon": "$(refresh)"
      },
      {
        "command": "altium365.tree.retryNode",
        "title": "Altium 365: Retry Tree Node",
        "category": "Altium 365"
      },
      {
        "command": "altium365.statusBar.click",
        "title": "Altium 365: Status Bar Menu",
        "category": "Altium 365"
      },
      {
        "command": "altium365.script.runLocal",
        "title": "Altium 365: Run Script (Local)",
        "category": "Altium 365"
      },
      {
        "command": "altium365.script.edit",
        "title": "Altium 365: Edit Script",
        "category": "Altium 365"
      },
      {
        "command": "altium365.script.executeRemote",
        "title": "Altium 365: Execute Script Remotely",
        "category": "Altium 365"
      },
      {
        "command": "altium365.script.publish",
        "title": "Altium 365: Publish Script",
        "category": "Altium 365"
      },
      {
        "command": "altium365.tree.copyId",
        "title": "Altium 365: Copy ID",
        "category": "Altium 365"
      },
      {
        "command": "altium365.workspace.openInBrowser",
        "title": "Altium 365: Open Workspace in Browser",
        "category": "Altium 365"
      },
      {
        "command": "altium365.project.openInBrowser",
        "title": "Altium 365: Open Project in Browser",
        "category": "Altium 365"
      }
    ],
    "configuration": {
      "title": "Altium 365 Scripting",
      "properties": {
        "altium365.graphqlEndpoint": {
          "type": "string",
          "default": "https://usw2.dev-365.altium.com/napi/gateway/graphql",
          "description": "Altium 365 GraphQL endpoint URL. Used to list workspaces and as ALTIUM365_GRAPHQL_ENDPOINT for scripts."
        },
        "altium365.clientId": {
          "type": "string",
          "default": "20C490ED-58EF-11EF-9194-02A5C34CA889",
          "description": "OAuth2 client_id of the desktop application."
        },
        "altium365.authEndpoint": {
          "type": "string",
          "default": "https://auth.dev1.altium.com/connect/authorize",
          "description": "OAuth2 authorization endpoint."
        },
        "altium365.tokenEndpoint": {
          "type": "string",
          "default": "https://auth.dev1.altium.com/connect/token",
          "description": "OAuth2 token endpoint."
        },
        "altium365.actionWaitEndpoint": {
          "type": "string",
          "default": "https://actionwait.dev1.altium.com/await",
          "description": "Altium ActionWait long-poll endpoint used to receive the OAuth authorization code from the browser callback. Populated automatically by 'Altium 365: Select Environment'."
        },
        "altium365.redirectUri": {
          "type": "string",
          "default": "https://auth.dev1.altium.com/api/AuthComplete",
          "description": "Fixed OAuth redirect URI registered with the Altium auth client (Altium-hosted authCompleted page). Must match the URI sent in both /connect/authorize and /connect/token. Populated automatically by 'Altium 365: Select Environment'."
        },
        "altium365.scopes": {
          "type": "string",
          "default": "openid profile",
          "description": "Space-delimited OAuth2 scopes."
        },
        "altium365.audience": {
          "type": "string",
          "default": "",
          "description": "Optional 'audience' parameter (Auth0-style providers)."
        },
        "altium365.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter. If empty, the ms-python.python extension or 'python' on PATH will be used."
        },
        "altium365.inputParametersPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a JSON file passed as `input_parameters` to onExecute. If empty, the runner looks for '<script>.params.json' next to the script."
        },
        "altium365.extraEnv": {
          "type": "object",
          "default": {},
          "description": "Extra environment variables passed to the Python process."
        },
        "altium365.injectHelper": {
          "type": "boolean",
          "default": true,
          "description": "Inject the bundled 'a365' helper module on PYTHONPATH so scripts can `import a365`."
        },
        "altium365.promptForProjectId": {
          "type": "boolean",
          "default": true,
          "description": "If no input_parameters file is configured/found, prompt for a projectId before running the script. The last value is remembered per workspace."
        },
        "altium365.activeEnvironment": {
          "type": "string",
          "default": "",
          "description": "Name of the active environment from `altium365.environments`. Managed by the 'Altium 365: Select Environment' command."
        },
        "altium365.environments": {
          "type": "object",
          "default": {
            "Dev": {
              "graphqlEndpoint": "https://usw2.dev-365.altium.com/napi/gateway/graphql",
              "authEndpoint": "https://auth.dev1.altium.com/connect/authorize",
              "tokenEndpoint": "https://auth.dev1.altium.com/connect/token",
              "actionWaitEndpoint": "https://actionwait.dev1.altium.com/await",
              "redirectUri": "https://auth.dev1.altium.com/api/AuthComplete",
              "scopes": "openid profile",
              "audience": ""
            },
            "Uat": {
              "graphqlEndpoint": "https://eur.uat-365.altium.com/napi/gateway/graphql",
              "authEndpoint": "https://auth.uat1.altium.com/connect/authorize",
              "tokenEndpoint": "https://auth.uat1.altium.com/connect/token",
              "actionWaitEndpoint": "https://actionwait.uat.altium.com/await",
              "redirectUri": "https://auth.uat1.altium.com/api/AuthComplete",
              "scopes": "openid profile",
              "audience": ""
            },
            "Prod": {
              "graphqlEndpoint": "https://eur.365.altium.com/napi/gateway/graphql",
              "authEndpoint": "https://auth.altium.com/connect/authorize",
              "tokenEndpoint": "https://auth.altium.com/connect/token",
              "actionWaitEndpoint": "https://actionwait.altium.com/await",
              "redirectUri": "https://auth.altium.com/api/AuthComplete",
              "scopes": "openid profile",
              "audience": ""
            }
          },
          "description": "Named environments. Each entry can override graphqlEndpoint, authEndpoint, tokenEndpoint, actionWaitEndpoint, redirectUri, scopes, audience. Use 'Altium 365: Select Environment' to switch.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "graphqlEndpoint": { "type": "string" },
              "authEndpoint": { "type": "string" },
              "tokenEndpoint": { "type": "string" },
              "actionWaitEndpoint": { "type": "string" },
              "redirectUri": { "type": "string" },
              "scopes": { "type": "string" },
              "audience": { "type": "string" }
            }
          }
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "altium365.script.publish",
          "when": "resourceScheme == altium365",
          "group": "navigation@1"
        },
        {
          "command": "altium365.script.executeRemote",
          "when": "resourceScheme == altium365",
          "group": "navigation@2"
        }
      ],
      "editor/title/run": [
        {
          "command": "altium365.runScript",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "altium365.debugScript",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "altium365.runScript",
          "when": "resourceLangId == python",
          "group": "navigation"
        },
        {
          "command": "altium365.debugScript",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "altium365.tree.refresh",
          "when": "view == altium365.tree",
          "group": "navigation"
        },
        {
          "command": "altium365.selectEnvironment",
          "when": "view == altium365.tree && altium365.signedIn",
          "group": "navigation",
          "icon": "$(globe)"
        }
      ],
      "view/item/context": [
        {
          "command": "altium365.script.runLocal",
          "when": "view == altium365.tree && viewItem == scriptNode",
          "group": "1_run@1"
        },
        {
          "command": "altium365.script.executeRemote",
          "when": "view == altium365.tree && viewItem == scriptNode",
          "group": "1_run@2"
        },
        {
          "command": "altium365.script.edit",
          "when": "view == altium365.tree && viewItem == scriptNode",
          "group": "2_edit@1"
        },
        {
          "command": "altium365.script.publish",
          "when": "view == altium365.tree && viewItem == scriptNode",
          "group": "2_edit@2"
        },
        {
          "command": "altium365.tree.copyId",
          "when": "view == altium365.tree && viewItem == workspaceNode",
          "group": "9_clipboard@1"
        },
        {
          "command": "altium365.tree.copyId",
          "when": "view == altium365.tree && viewItem == projectNode",
          "group": "9_clipboard@1"
        },
        {
          "command": "altium365.tree.copyId",
          "when": "view == altium365.tree && viewItem == scriptNode",
          "group": "9_clipboard@1"
        },
        {
          "command": "altium365.workspace.openInBrowser",
          "when": "view == altium365.tree && viewItem == workspaceNode",
          "group": "9_open@1"
        },
        {
          "command": "altium365.project.openInBrowser",
          "when": "view == altium365.tree && viewItem == projectNode",
          "group": "9_open@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.9.1"
  }
}
